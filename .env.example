# Copy to .env without replacing an existing file; never commit real credentials.
# Used by scripts/dev.sh and VS Code's CampusLife (dev) launch configuration.
# Use simple KEY=value lines; quote shell-special characters when using dev.sh.
# For existing services, keep their accounts/data and use matching credentials.
DB_USER=campuslife
DB_PASSWORD=replace-with-local-database-password
REDIS_PASSWORD=replace-with-local-redis-password

# Optional defaults. Keep TEST_DB_URL pointed exactly at campuslife_test.
# DB_URL='jdbc:mysql://127.0.0.1:3306/campuslife?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&sslMode=DISABLED'
# TEST_DB_URL='jdbc:mysql://127.0.0.1:3306/campuslife_test?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&sslMode=DISABLED'
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# SERVER_PORT=8080
# MANAGEMENT_PORT=8081
